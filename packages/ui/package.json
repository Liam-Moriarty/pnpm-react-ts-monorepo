{
  "name": "@repo/ui",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./counter": {
      "types": "./dist/components/counter.d.ts",
      "default": "./dist/components/counter.js"
    },
    "./header": {
      "types": "./dist/components/header.d.ts",
      "default": "./dist/components/header.js"
    },
    "./setup-counter": {
      "types": "./dist/utils/counter.d.ts",
      "default": "./dist/utils/counter.js"
    }
  },
  "sideEffects": false,
  "license": "MIT",
  "scripts": {
    "lint": "eslint . --ext ts,tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'dist/**'",
    "build": "tsc"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^8.57.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
